include README.md
include requirements.txt
include LICENSE
include uv.lock

include grakel/kernels/_c_functions/*.pxd
include grakel/kernels/_c_functions/*.pyx
recursive-include grakel/kernels/_c_functions/include *
recursive-include grakel/kernels/_c_functions/src *

recursive-include grakel/kernels/_isomorphism/bliss-0.50 *
recursive-include grakel/kernels/_isomorphism *

recursive-include tests/data/Cuneiform *
recursive-include tests/data/MUTAG *
recursive-include tests/regression/data *.json
recursive-include tests/regression/expected *.json
include tests/regression/README.md
include tests/regression/test_regression.py

include doc/*.rst
include doc/conf.py
include doc/Makefile
include doc/make.bat
recursive-include doc/documentation *
recursive-include doc/benchmarks *
recursive-include doc/_static *
recursive-include doc/_templates *
recursive-include doc/kernels *
recursive-include doc/sphinxext *
recursive-include examples *

global-exclude .DS_Store
global-exclude *.py[cod]
